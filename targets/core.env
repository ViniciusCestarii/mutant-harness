# Target profile: Bitcoin Core. Sourced by bin/mutant-harness, parsed by
# bin/mutant-export. Plain KEY=value lines only.
TARGET_NAME=core
REPO_URL=https://github.com/bitcoin/bitcoin.git
# Export only
GITHUB_REPO=bitcoin/bitcoin
IMAGE=mutant-harness-core:latest
CMAKE_FLAGS="-DBUILD_GUI=OFF -DWITH_ZMQ=OFF -DENABLE_IPC=OFF"
APT_PACKAGES="libboost-dev libevent-dev libsqlite3-dev"
# Units a header is syntax-checked through. Empty: headers are not checked.
TU_HEADER_UNITS=""
VERIFY_DEFAULT_ARGS=""
# Export only
TEST_COMMAND='ctest --test-dir build -j$(nproc) && build/test/functional/test_runner.py -j$(nproc) --failfast'
# Export only
ENVIRONMENT="Debian bookworm, GCC (build-essential), cmake"
