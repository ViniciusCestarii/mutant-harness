# Target profile: bitcoin-core/secp256k1.
TARGET_NAME=secp256k1
REPO_URL=https://github.com/bitcoin-core/secp256k1.git
IMAGE=mutant-harness-secp256k1:latest
CMAKE_FLAGS="-DSECP256K1_ENABLE_MODULE_RECOVERY=ON -DSECP256K1_VALGRIND=ON -DSECP256K1_BUILD_BENCHMARK=OFF"
APT_PACKAGES="valgrind"
# Nearly all of the library is headers included into src/secp256k1.c, which
# src/tests.c includes in turn; a header is checked through these units.
TU_HEADER_UNITS="src/tests.c src/tests_exhaustive.c"
VERIFY_STAGES="ctest ctime"
