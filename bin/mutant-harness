#!/usr/bin/env bash
# mutant-harness - have an agent read one file of a target tree (Bitcoin Core,
# libsecp256k1) and plant mutants in it.
#
#   mutant-harness --file src/script/interpreter.cpp
#   mutant-harness --file src/net_processing.cpp --count 20 --focus "compact blocks"
#   mutant-harness --target secp256k1 --file src/modules/schnorrsig/main_impl.h
#
set -euo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET="core"
AGENT="${AGENT:-claude}"

TARGET_FILE=""
COUNT=""
FOCUS=""
LINE_RANGE=""
OPS=""
STRUCTURAL=0
OUT_ROOT="$PWD/results"
REVIEW=0
REVIEW_MODEL=""
FALLBACK_MODEL=""
REPO_MOUNT=""
BIPS_REPO_MOUNT=""
VERIFY_CONTAINER=0
VERIFY_REPO=""
VERIFY_ARGS=()
VERIFY_ONLY_DIR=""
REVIEW_ONLY_DIR=""
REVIEW_ONLY_COMMIT=""
EXPORT=0
REBUILD=0
UPDATE_CORE=0
PR=""
UPDATE_BIPS=0
SHELL_MODE=0
TIMEOUT=""
DETACH=0
APPLY_PATCH=""
EXTRA_DOCKER_ARGS=()
WORKERS=1
NO_CACHE=0

log()  { printf '\033[36m[mutant-harness]\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[33m[mutant-harness]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[31m[mutant-harness]\033[0m %s\n' "$*" >&2; exit 1; }
case "$AGENT" in
    claude) MODEL="opus" ;;
    codex)  MODEL="gpt-6-astra" ;;
    *)      die "AGENT must be claude or codex, got: $AGENT" ;;
esac
# Wall time since the script started, image build included. Trapped on EXIT
# once a run starts, so every way out of it reports.
report_time() {
    local rc=$?
    log "finished in $((SECONDS / 60))m$((SECONDS % 60))s"
    if [[ -n "${SUMMARY_FILE:-}" ]]; then write_summary "$rc"; fi
}
STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

cost_of() {  # cost_of <stream>: what the agent of one stream-json log cost, in USD, or null when the CLI reports no cost
    [[ -s "$1" ]] || { echo 0; return; }
    jq -n '[inputs |
        if .type == "result" then .total_cost_usd // 0
        elif .type == "thread.started" or .type == "turn.completed" or .type == "turn.failed" or .type == "error" then null
        else empty end] | if any(.[]; . == null) then null else add // 0 end' "$1" 2>/dev/null || echo null
}

# One JSON for the whole run (SUMMARY_DIRS, written to SUMMARY_FILE): wall time,
# what the agents cost and where every mutant ended up. A reused file's
# generation was paid for by the run it came from, so it costs nothing here.
write_summary() {  # write_summary <exit-code>
    command -v jq >/dev/null || return 0
    local d m r v gen rev
    for d in "${SUMMARY_DIRS[@]}"; do
        m="$d/out/mutants.json";          [[ -s "$m" ]] || m=/dev/null
        r="$d/out/verify/results.jsonl";  [[ -s "$r" ]] || r=/dev/null
        v="$d/out/mutants-reviewed.json"; [[ -s "$v" ]] || v=/dev/null
        gen=0; [[ -f "$d/reused-from" ]] || gen="$(cost_of "$d/out/session.stream.jsonl")"
        rev="$(cost_of "$d/out/review.stream.jsonl")"
        jq -n --arg dir "$d" --arg reused "$(cat "$d/reused-from" 2>/dev/null)" \
            --argjson gen "$gen" --argjson rev "$rev" \
            --slurpfile m "$m" --slurpfile r "$r" --slurpfile v "$v" '
            ($m[0].mutants // []) as $ms
            | {file: ($m[0].target.file // ($dir | split("/") | last)),
               run_dir: $dir,
               commit: $m[0].repo.commit,
               reused_from: (if $reused == "" then null else $reused end),
               cost_usd: {generation: $gen, review: $rev},
               mutants: {
                 generated:      ($ms | length),
                 apply_failed:   [$ms[] | select(.apply_ok == false)] | length,
                 compile_failed: [$ms[] | select(.compiles_ok == false)] | length,
                 verify: (reduce ($ms[] | .id as $id | [$r[] | select(.id == $id)] | last
                                  | .status // "not-verified") as $s ({}; .[$s] += 1)),
                 review: ($v[0].review // null | if . then {good, dead, noise, invalid} else null end)}}'
    done | jq -s --arg pr "$PR" --arg started "$STARTED_AT" \
              --arg finished "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
              --argjson secs "$SECONDS" --argjson rc "$1" '
        def sum_counts: reduce (.[] | select(.) | to_entries[]) as $e ({}; .[$e.key] += $e.value);
        def sum_costs: if any(.[]; . == null) then null else add end;
        {pr: (if $pr == "" then null else ($pr | tonumber) end),
         commit: (map(.commit) | map(select(.)) | first),
         started_at: $started, finished_at: $finished, duration_seconds: $secs,
         exit_code: $rc,
         cost_usd: {generation: (map(.cost_usd.generation) | sum_costs),
                    review:     (map(.cost_usd.review) | sum_costs),
                    total:      ([.[] | .cost_usd.generation, .cost_usd.review] | sum_costs)},
         mutants: {generated:      (map(.mutants.generated) | add),
                   apply_failed:   (map(.mutants.apply_failed) | add),
                   compile_failed: (map(.mutants.compile_failed) | add),
                   verify:         (map(.mutants.verify) | sum_counts),
                   review:         (map(.mutants.review) | sum_counts)},
         files: .}' > "$SUMMARY_FILE" \
        && log "summary json: $SUMMARY_FILE" \
        || warn "could not write $SUMMARY_FILE"
}

usage() {
    cat >&2 <<'EOF'
mutant-harness - run Claude Code or Codex in a container to plant mutants in one file

Usage:
  mutant-harness [--target <name>] --file <path-in-tree> [options]
  mutant-harness --apply <patch> --repo <clone>

Options:
  --target <name>      Which tree to mutate, from targets/<name>.env: core
                       (Bitcoin Core, the default) or secp256k1. Each target
                       has its own image, prompts and verify build volume.
  --file <path>        File to mutate, relative to the target tree
                       (e.g. src/script/interpreter.cpp). Required, unless
                       --pr is given: then every source file the PR adds
                       lines to is mutated, one run each
  --count <n>          How many mutants to aim for (default: 12, or 6 with
                       --pr, which also drops low-severity ones)
  --focus <text>       Steer the agent at one area ("segwit v1 witness parsing",
                       "the fee estimator", a function name, ...)
  --lines <a-b>        Restrict mutations to this line range of the file
  --ops <list>         Comma-separated operator classes to prefer, from:
                       deletion, relocation, reorder, boundary, condition,
                       constant, scope, state, error-handling, numeric,
                       early-exit, injection, concurrency (core),
                       constant-time (secp256k1), serialization
  --structural         Skip what a line-by-line tool (bcore-mutation) already
                       produces: one-token swaps and single-line deletions.
                       The agent is told to avoid them, every patch is
                       classified from its diff (`line_level`), and line-level
                       mutants are not verified
  --out <dir>          Output root (default: ./results); results land in
                       <dir>/<file-slug>-<timestamp>/, or with --pr in
                       <dir>/pr-<n>-<timestamp>/<file-slug>/.
  --model <name>       Model for the mutator (default: opus for Claude,
                       gpt-6-astra for Codex)
  --review             Run the second-pass review of the mutants (default: off).
                       With verification it runs after it, on the survivors.
  --review-model <n>   Model for the review pass (default: same as --model)
  --review-only <dir>  Review an existing run directory's mutants and exit: no
                       generation, no verification. A --pr run's directory
                       reviews each of its files at once.
  --fallback-model <n> Fallback when the primary is overloaded (Claude only)
  --repo <path>        Mount a host clone of the target instead of the baked-in one
  --bips-repo <path>   Mount a host bitcoin/bips clone instead of the baked-in one
  --verify             When the run finishes, build and test every mutant that
                       applies and compiles, in a second container. Needs no
                       host toolchain and always runs against the commit the
                       patches were cut against. Hours of machine time; the
                       build tree is kept in a docker volume between runs.
  --verify-repo <path> Verify in this host clone instead, for testing the
                       mutants against a tree of your own. Must be clean and
                       already configured (cmake -B).
  --verify-arg <arg>   Extra arg for the mutant-verify run (repeatable), e.g.
                       --verify-arg --skip-functional
  --verify-only <dir>  Verify an existing run directory and exit: no agent, no
                       generation. Use it to resume an interrupted verification
                       (with --verify-arg --resume) or to verify an old run.
  --workers <n>        With --pr --verify, verify up to n files at once, each in
                       its own copy of the build volume (default: 1). Every
                       copy is another ~5 GB of disk and another test suite's
                       worth of RAM.
  --no-cache           With --pr, generate every file anew instead of reusing
                       the mutants of an earlier run of the same PR
  --export             After verification, write the live mutants to
                       out/import.json with bin/mutant-export
  --update-core        git fetch master inside the container first
  --pr <n>             Mutate the head of GitHub pull request <n> instead of
                       master (fetched inside the container), and only the
                       lines the PR adds
  --update-bips        git fetch the bips repo too
  --rebuild            Rebuild the docker image first
  --build-only         Build the image and exit
  --timeout <dur>      Kill the run after this long (e.g. 45m); needs `timeout`
  --detach             Run the container in the background and print its name
  --shell              Drop into a shell in the container instead of mutating
  --docker-arg <arg>   Extra arg passed through to `docker run` (repeatable)
  --apply <patch>      Apply one produced patch to --repo and exit (no container)
  -h, --help           This help

Agent: AGENT=claude (default) or codex.
Auth: Claude uses ANTHROPIC_API_KEY or a copy of ~/.claude/.credentials.json.
Codex uses OPENAI_API_KEY or a copy of ~/.codex/auth.json
(under CODEX_HOME when set). Host credential files are never modified.
EOF
}

BUILD_ONLY=0
# Kept for re-running ourselves once per file of a --pr run.
ORIG_ARGS=("$@")
while [[ $# -gt 0 ]]; do
    case "$1" in
        --target)         TARGET="${2:?}"; shift 2 ;;
        --file)           TARGET_FILE="${2:?}"; shift 2 ;;
        --count)          COUNT="${2:?}"; shift 2 ;;
        --focus)          FOCUS="${2:?}"; shift 2 ;;
        --lines)          LINE_RANGE="${2:?}"; shift 2 ;;
        --ops)            OPS="${2:?}"; shift 2 ;;
        --structural)     STRUCTURAL=1; shift ;;
        --out)            OUT_ROOT="${2:?}"; shift 2 ;;
        --model)          MODEL="${2:?}"; shift 2 ;;
        --review)         REVIEW=1; shift ;;
        --review-model)   REVIEW_MODEL="${2:?}"; shift 2 ;;
        --review-only)    REVIEW_ONLY_DIR="${2:?}"; shift 2 ;;
        --fallback-model) FALLBACK_MODEL="${2:?}"; shift 2 ;;
        --repo)           REPO_MOUNT="${2:?}"; shift 2 ;;
        --bips-repo)      BIPS_REPO_MOUNT="${2:?}"; shift 2 ;;
        --verify)         VERIFY_CONTAINER=1; shift ;;
        --verify-repo)    VERIFY_REPO="${2:?}"; shift 2 ;;
        --verify-arg)     VERIFY_ARGS+=("${2:?}"); shift 2 ;;
        --verify-only)    VERIFY_ONLY_DIR="${2:?}"; shift 2 ;;
        --export)         EXPORT=1; shift ;;
        --update-core)    UPDATE_CORE=1; shift ;;
        --pr)             PR="${2:?}"; shift 2 ;;
        --update-bips)    UPDATE_BIPS=1; shift ;;
        --rebuild)        REBUILD=1; shift ;;
        --build-only)     BUILD_ONLY=1; shift ;;
        --timeout)        TIMEOUT="${2:?}"; shift 2 ;;
        --detach)         DETACH=1; shift ;;
        --shell)          SHELL_MODE=1; shift ;;
        --apply)          APPLY_PATCH="${2:?}"; shift 2 ;;
        --docker-arg)     EXTRA_DOCKER_ARGS+=("${2:?}"); shift 2 ;;
        --workers)        WORKERS="${2:?}"; shift 2 ;;
        --no-cache)       NO_CACHE=1; shift ;;
        -h|--help)        usage; exit 0 ;;
        *)                die "unknown option: $1 (try --help)" ;;
    esac
done
[[ "$AGENT" != codex || -z "$FALLBACK_MODEL" ]] || die "--fallback-model is only supported by Claude"
# The run directory --verify-only or --review-only works on.
ONLY_DIR="${VERIFY_ONLY_DIR:-$REVIEW_ONLY_DIR}"

# Prefix every line with the file being run
if [[ -z "${MUTANT_HARNESS_PREFIXED:-}" && "$SHELL_MODE" == 0 && "$DETACH" == 0 && -z "$APPLY_PATCH" ]]; then
    prefix_file="$TARGET_FILE"
    if [[ -z "$prefix_file" && -n "$ONLY_DIR" ]] && command -v jq >/dev/null; then
        for m in "$ONLY_DIR/out/mutants.json" "$ONLY_DIR/mutants.json"; do
            [[ -f "$m" ]] || continue
            prefix_file="$(jq -r '.target.file // empty' "$m" 2>/dev/null || true)"
            break
        done
    fi
    if [[ -n "$prefix_file" ]]; then
        prefix_file="${prefix_file#./}"
        rc=0
        MUTANT_HARNESS_PREFIXED=1 "$0" "${ORIG_ARGS[@]}" 2>&1 | sed -u "s|^|[${prefix_file#src/}] |" || rc=$?
        exit "$rc"
    fi
fi

# --------------------------------------------------------------- target ----
# Everything that differs between targets - repo, image, cmake flags, header
# check units, verify stages - lives in one profile.
PROFILE="$HERE/targets/$TARGET.env"
[[ "$TARGET" =~ ^[a-z0-9_-]+$ && -r "$PROFILE" ]] \
    || die "unknown --target $TARGET (have: $(cd "$HERE/targets" && ls *.env | sed 's/\.env$//' | tr '\n' ' '))"
# shellcheck source=/dev/null
source "$PROFILE"
IMAGE="${MUTANT_HARNESS_IMAGE:-$IMAGE}"
# The build tree the verification phase keeps between runs. Cold-building the
# target is the expensive half of verifying, and it is only paid once per volume.
if [[ "$TARGET_NAME" == core ]]; then
    VERIFY_VOLUME="${MUTANT_HARNESS_BUILD_VOLUME:-mutant-harness-build}"
else
    VERIFY_VOLUME="${MUTANT_HARNESS_BUILD_VOLUME:-mutant-harness-build-$TARGET_NAME}"
fi
# The profile's stages go first so a --verify-arg can still add to them.
VERIFY_ARGS=(--stages "$VERIFY_STAGES" ${VERIFY_ARGS[@]+"${VERIFY_ARGS[@]}"})
# A run can only be verified in the image of the target it was cut from; say so
# before building or starting the wrong one.
if [[ -n "$ONLY_DIR" ]] && command -v jq >/dev/null; then
    for m in "$ONLY_DIR/out/mutants.json" "$ONLY_DIR/mutants.json"; do
        [[ -f "$m" ]] || continue
        made_for="$(jq -r '.harness.target // "core"' "$m" 2>/dev/null || true)"
        [[ -z "$made_for" || "$made_for" == "$TARGET_NAME" ]] \
            || die "$ONLY_DIR was generated with --target $made_for; pass --target $made_for"
        break
    done
fi

# ----------------------------------------------------------------- apply ----
# Applying a produced mutant to a real clone is a local git operation; it needs
# no image and no agent, so handle it before anything else.
if [[ -n "$APPLY_PATCH" ]]; then
    [[ -r "$APPLY_PATCH" ]] || die "cannot read $APPLY_PATCH"
    [[ -n "$REPO_MOUNT" ]]  || die "--apply needs --repo <core-clone>"
    [[ -d "$REPO_MOUNT/.git" ]] || die "--repo $REPO_MOUNT is not a git clone"
    git -C "$REPO_MOUNT" apply --check "$(cd "$(dirname "$APPLY_PATCH")" && pwd)/$(basename "$APPLY_PATCH")" \
        || die "patch does not apply to $REPO_MOUNT (wrong commit?)"
    git -C "$REPO_MOUNT" apply "$(cd "$(dirname "$APPLY_PATCH")" && pwd)/$(basename "$APPLY_PATCH")"
    log "applied $(basename "$APPLY_PATCH") to $REPO_MOUNT"
    log "revert with: git -C $REPO_MOUNT checkout -- ."
    exit 0
fi

# --------------------------------------------------------------- verify ----
# Everything verification needs, checked now rather than when the run finishes.
# The whole point of chaining is not to babysit it, and a clone found dirty an
# hour later is the difference between a verified run and a wasted one.
VERIFY=0
if [[ "$VERIFY_CONTAINER" == 1 || -n "$VERIFY_REPO" || -n "$VERIFY_ONLY_DIR" ]]; then
    VERIFY=1
    if [[ "$VERIFY_CONTAINER" == 1 && -n "$VERIFY_REPO" ]]; then
        die "--verify and --verify-repo are the same job in two places; pick one"
    fi
    VERIFIER="$HERE/bin/mutant-verify"
    [[ -x "$VERIFIER" ]] || die "verification needs $VERIFIER"
    [[ "$DETACH" == 0 && "$SHELL_MODE" == 0 ]] \
        || die "verification cannot be combined with --detach or --shell (it runs once the container exits)"
fi
[[ "$EXPORT" == 0 || "$VERIFY" == 1 ]] || die "--export needs --verify, --verify-repo or --verify-only"
if [[ -n "$VERIFY_REPO" ]]; then
    [[ -d "$VERIFY_REPO/.git" ]] || die "--verify-repo $VERIFY_REPO is not a git clone"
    [[ -z "$(git -C "$VERIFY_REPO" status --porcelain --untracked-files=no)" ]] \
        || die "--verify-repo $VERIFY_REPO has uncommitted changes; commit or stash them first"
    VERIFY_REPO="$(cd "$VERIFY_REPO" && pwd)"
fi

# Hand a finished run's patches to the verifier. Only the mutants that apply and
# compile: the others would each burn a build to prove what the manifest already
# says. A --structural run also leaves out its line-level mutants, which a
# line-by-line tool tests far more cheaply. Verdicts from --review are *not* filtered on - a `noise` call is
# still a model's opinion, and testing it is how you find out the model was
# wrong. Either mode's exit code is ours; --export runs only when it succeeded.
run_verification() {  # run_verification <out-dir> <container-name>
    local out_dir="$1" name="$2" rc=0
    local manifest="$out_dir/mutants.json"

    [[ -s "$manifest" ]] || die "no mutants.json in $out_dir"
    jq empty "$manifest" 2>/dev/null || die "$manifest is not valid JSON"
    [[ -d "$out_dir/patches" ]] || die "no patches directory in $out_dir"
    out_dir="$(cd "$out_dir" && pwd)"

    local runnable
    runnable="$(jq -r '(.harness.structural // false) as $structural
                       | [.mutants[]? | select(.apply_ok and (.compiles_ok != false)
                                               and (($structural | not) or .line_level != true))
                          | .id]
                       | join(",")' "$manifest")"
    if [[ -z "$runnable" ]]; then
        warn "no mutant both applies and compiles; nothing to verify"
        exit 0
    fi
    echo

    if [[ -n "$VERIFY_REPO" ]]; then
        log "verifying ${runnable//,/ } in $VERIFY_REPO"
        "$VERIFIER" --repo "$VERIFY_REPO" --patches "$out_dir/patches" \
            --only "$runnable" ${VERIFY_ARGS[@]+"${VERIFY_ARGS[@]}"} || rc=$?
        export_live "$out_dir" "$rc" "$VERIFY_REPO"
    fi

    # A second container, not the generating one: this phase wants CPU for hours
    # and has no business holding a copy of your credentials. It verifies against
    # the commit the patches were cut against, which is the one the image
    # already has, so `apply-failed` from a drifted clone cannot happen. The
    # build tree lives in a named volume, because cold-building Core is the
    # expensive half of this and the volume is what makes it a one-off.
    local commit; commit="$(jq -r '.repo.commit // ""' "$manifest")"
    log "verifying ${runnable//,/ } in a container (build volume: $VERIFY_VOLUME)"
    # On the default bridge the container's only IPv6 address is ::1, and
    # libevent (the RPC server of older Core commits) then will not bind ::1:
    # rpc_bind.py --ipv6 and interface_bitcoin_cli.py fail the baseline.
    local network=mutant-harness-verify
    docker network inspect "$network" >/dev/null 2>&1 \
        || docker network create --ipv6 "$network" >/dev/null \
        || die "cannot create the IPv6 docker network $network"
    local args=(
        run --rm
        --name "$name"
        --network "$network"
        --user "$(id -u):$(id -g)"
        -v "$out_dir:/out"
        -v "$VERIFY_VOLUME:/src/bitcoin/build"
        -v "$VERIFIER:/usr/local/bin/mutant-verify:ro"
        -e "PATCH_DIR=/out/patches"
        -e "VERIFY_ONLY=$runnable"
        -e "VERIFY_COMMIT=$commit"
        -e "HOME=/home/agent"
        --entrypoint /usr/local/bin/verify-entrypoint.sh
    )
    [[ -n "$REPO_MOUNT" ]] && args+=(-v "$(cd "$REPO_MOUNT" && pwd):/src/bitcoin")
    [[ ${#EXTRA_DOCKER_ARGS[@]} -gt 0 ]] && args+=("${EXTRA_DOCKER_ARGS[@]}")
    docker "${args[@]}" "$IMAGE" ${VERIFY_ARGS[@]+"${VERIFY_ARGS[@]}"} || rc=$?
    export_live "$out_dir" "$rc" "$REPO_MOUNT"
}

# Finish a verification: write out/import.json when --export asked for it, then
# exit with the verifier's code. A failed export only warns, it does not turn a
# good verification into a failed one.
export_live() {  # export_live <out-dir> <verify-rc> <core-clone-or-empty>
    local out_dir="$1" rc="$2" repo="$3"
    if [[ "$EXPORT" == 1 && "$rc" == 0 ]]; then
        if "$HERE/bin/mutant-export" "$out_dir" -o "$out_dir/import.json" \
               ${repo:+--repo "$repo"}; then
            log "import file:      $out_dir/import.json"
        else
            warn "export failed; retry with: mutant-export $out_dir -o $out_dir/import.json"
        fi
    fi
    exit "$rc"
}

command -v docker >/dev/null || die "docker not found on PATH"

# ---------------------------------------------------------------- image ----
build_image() {
    log "building $IMAGE (first build clones $TARGET_NAME and the BIPs, a few minutes)"
    # --rebuild is how a user gets a fresh clone, which a cached layer would hide.
    local bust=()
    [[ "$REBUILD" == 1 ]] && bust=(--build-arg "CLONE_CACHE_BUST=$(date +%s)")
    docker build -t "$IMAGE" ${bust[@]+"${bust[@]}"} \
        --build-arg "AGENT=$AGENT" \
        --build-arg "TARGET_NAME=$TARGET_NAME" \
        --build-arg "REPO_URL=$REPO_URL" \
        --build-arg "CMAKE_FLAGS=$CMAKE_FLAGS" \
        --build-arg "APT_PACKAGES=$APT_PACKAGES" \
        --build-arg "TU_HEADER_UNITS=$TU_HEADER_UNITS" \
        "$HERE/docker"
}

# What this harness needs the image to contain. Bumped in the Dockerfile too.
IMAGE_VERSION=13

image_label() {
    docker image inspect "$IMAGE" --format "{{index .Config.Labels \"$1\"}}" 2>/dev/null
}

# An image with our tag but without our label belongs to something else; rebuild
# rather than silently running a stranger's entrypoint.
image_is_ours()    { [[ "$(image_label org.mutant-harness.kind)" == "core-mutant-gen" \
                         && "$(image_label org.mutant-harness.target)" == "$TARGET_NAME" ]]; }
image_is_current() { [[ "$(image_label org.mutant-harness.version)" == "$IMAGE_VERSION" \
                         && "$(image_label org.mutant-harness.agent)" == "$AGENT" ]]; }

if [[ "$REBUILD" == 1 ]] || ! image_is_ours || ! image_is_current; then
    if docker image inspect "$IMAGE" >/dev/null 2>&1 && [[ "$REBUILD" == 0 ]]; then
        if image_is_ours; then
            warn "$IMAGE needs harness v$IMAGE_VERSION with agent $AGENT; rebuilding"
        else
            warn "$IMAGE exists but is not a mutant-harness image; rebuilding over it"
        fi
    fi
    build_image
fi
[[ "$BUILD_ONLY" == 1 ]] && { log "image ready: $IMAGE"; exit 0; }

# ------------------------------------------------------------ verify only ----
# Verifying an existing run needs no agent and no --file: the patches and the
# manifest already exist. This is also how an interrupted verification is
# resumed, with --verify-arg --resume.
if [[ -n "$VERIFY_ONLY_DIR" ]]; then
    [[ -d "$VERIFY_ONLY_DIR" ]] || die "--verify-only $VERIFY_ONLY_DIR is not a directory"
    RUN_DIR="$(cd "$VERIFY_ONLY_DIR" && pwd)"
    # Take either the run directory or its out/ directly.
    if [[ -f "$RUN_DIR/out/mutants.json" ]]; then
        VERIFY_OUT="$RUN_DIR/out"
    elif [[ -f "$RUN_DIR/mutants.json" ]]; then
        VERIFY_OUT="$RUN_DIR"
    else
        die "no mutants.json under $RUN_DIR (pass a run directory from results/)"
    fi
    log "verify only: $VERIFY_OUT"
    trap report_time EXIT
    run_verification "$VERIFY_OUT" "mutant-harness-verify-$(basename "$RUN_DIR")"
fi

# ------------------------------------------------------------ review only ----
# Reviewing an existing run runs the second pass alone, on the mutants and
# patches already there, against the commit they were cut from. That is how to
# judge the review against verdicts you already have for the same mutants. A
# --pr run's directory holds one run per file; each is reviewed, all at once.
if [[ -n "$REVIEW_ONLY_DIR" ]]; then
    [[ -z "$TARGET_FILE$PR$VERIFY_ONLY_DIR" ]] || die "--review-only takes no --file, --pr or --verify-only"
    [[ -d "$REVIEW_ONLY_DIR" ]] || die "--review-only $REVIEW_ONLY_DIR is not a directory"
    RUN_DIR="$(cd "$REVIEW_ONLY_DIR" && pwd)"
    if [[ ! -f "$RUN_DIR/out/mutants.json" ]]; then
        subs=("$RUN_DIR"/*/out/mutants.json)
        [[ -f "${subs[0]}" ]] || die "no mutants.json under $RUN_DIR (pass a run directory from results/)"
        trap report_time EXIT
        pass=()
        set -- "${ORIG_ARGS[@]}"
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --rebuild)     shift ;;
                --review-only) shift 2 ;;
                *)             pass+=("$1"); shift ;;
            esac
        done
        pids=() failed=()
        for m in "${subs[@]}"; do
            "$0" ${pass[@]+"${pass[@]}"} --review-only "${m%/out/mutants.json}" &
            pids+=("$!")
        done
        for i in "${!subs[@]}"; do
            wait "${pids[$i]}" || failed+=("${subs[$i]%/out/mutants.json}")
        done
        (( ${#failed[@]} == 0 )) || die "failed: ${failed[*]}"
        exit 0
    fi
    TARGET_FILE="$(jq -r '.target.file // empty' "$RUN_DIR/out/mutants.json")"
    REVIEW_ONLY_COMMIT="$(jq -r '.repo.commit // empty' "$RUN_DIR/out/mutants.json")"
    [[ -n "$TARGET_FILE" && -n "$REVIEW_ONLY_COMMIT" ]] \
        || die "$RUN_DIR/out/mutants.json names no target file or commit"
    # Nothing to review is not worth a container and a fetch.
    if [[ "$(jq '.mutants | length' "$RUN_DIR/out/mutants.json")" == 0 ]]; then
        log "$TARGET_FILE: no mutants to review"
        exit 0
    fi
    REVIEW=1
    # The run below then uses this run dir instead of starting a new one.
    MUTANT_HARNESS_RUN_DIR="$RUN_DIR"
fi

slug_of() { printf '%s' "$1" | tr '/.' '--' | sed 's/^-*//'; }

# Reviewed after verification, a run skips the mutants the tests killed. These
# are the arguments of ours that the later --review-only still needs.
review_args() {
    local out=()
    set -- "${ORIG_ARGS[@]}"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --model|--review-model|--target|--repo|--bips-repo|--docker-arg) out+=("$1" "$2"); shift 2 ;;
            *) shift ;;
        esac
    done
    (( ${#out[@]} )) || return 0
    printf '%s\0' "${out[@]}"
}

# -------------------------------------------------------------- pr files ----
# --pr without --file mutates every source file the PR adds lines to, one run
# (and run dir) each, by re-running ourselves with --file. Tests and benchmarks
# are skipped: mutating the tests says nothing about them.
if [[ -n "$PR" && -z "$TARGET_FILE" ]]; then
    [[ "$PR" =~ ^[0-9]+$ ]] || die "--pr takes a pull request number, got: $PR"
    [[ "$SHELL_MODE" == 0 ]] || die "--shell needs --file"
    [[ "$WORKERS" =~ ^[1-9][0-9]*$ ]] || die "--workers takes a positive number, got: $WORKERS"
    command -v curl >/dev/null || die "--pr without --file needs curl"
    REPO_PATH="${REPO_URL#https://github.com/}"; REPO_PATH="${REPO_PATH%.git}"
    diff="$(curl -fsSL --retry 3 -H "Accept: application/vnd.github.v3.diff" \
        "https://api.github.com/repos/${REPO_PATH}/pulls/$PR")" \
        || die "cannot download the diff of pull request #$PR"
    files=()
    while IFS=$'\t' read -r has_code f; do
        if [[ ! "$f" =~ \.(c|cc|cpp|h|hpp)$ || "$f" =~ (^|/)(test|bench) ]]; then
            log "skipping $f (not a source file, or a test or benchmark)"
        elif [[ "$f" == src/qt/* && "$CMAKE_FLAGS" == *-DBUILD_GUI=OFF* ]]; then
            log "skipping $f (the GUI is not built, so no mutant of it can be verified)"
        elif [[ "$has_code" == 0 ]]; then
            log "skipping $f (the PR adds only comments, includes and blank lines to it)"
        else
            files+=("$f")
        fi
    # Only files with an added line: a file the PR only deletes from has nothing
    # left to mutate. An added line counts as code unless it is blank, an
    # #include (it either breaks the build or changes nothing) or inside a
    # comment; context lines are followed too, so a /* opened above an added line
    # is seen. A hunk may start inside a comment opened above it, so each hunk is
    # read both ways, and a */ that closes nothing says it started inside one.
    done < <(awk 'function code(s,  i, j) {
                      while (1) {
                          if (incmt) { i = index(s, "*/"); if (!i) return 0; s = substr(s, i + 2); incmt = 0 }
                          sub(/^[ \t\r]+/, "", s)
                          if (s == "" || s ~ /^\/\// || s ~ /^#[ \t]*include/) return 0
                          if (s !~ /^\/\*/) {
                              i = index(s, "*/"); j = index(s, "/*")
                              if (i && (!j || i < j)) stray = 1
                              return 1
                          }
                          s = substr(s, 3); incmt = 1
                      }
                  }
                  function flush() {
                      if (stray_seen ? anyb : anya) seen[f] = 1
                      anya = anyb = stray_seen = 0; ia = 0; ib = 1
                  }
                  /^diff --git /   { flush(); hdr = 1; next }
                  hdr && /^\+\+\+ b\// { f = substr($0, 7) }
                  hdr && /^@@/   { hdr = 0; flush(); next }
                  hdr || f == "" || /^-/ { next }
                  /^@@/          { flush(); next }
                  { s = substr($0, 2)
                    incmt = ia; stray = 0; ca = code(s); ia = incmt; if (stray) stray_seen = 1
                    incmt = ib; cb = code(s); ib = incmt }
                  /^\+/ { if (!(f in seen)) { seen[f] = 0; order[++n] = f }; if (ca) anya = 1; if (cb) anyb = 1 }
                  END   { flush(); for (i = 1; i <= n; i++) print seen[order[i]] "\t" order[i] }' <<< "$diff")
    (( ${#files[@]} )) || die "pull request #$PR adds code to no source file"
    log "pull request #$PR: ${#files[@]} file(s): ${files[*]}"
    trap report_time EXIT

    # The image is current by now; do not rebuild it once per file. Every file
    # is generated at once, without the verification flags; the runs are then
    # verified one after another, since they share one build volume and the
    # CPU. They share one commit too, so only the first runs the baseline.
    gen_args=() ver_args=()
    set -- "${ORIG_ARGS[@]}"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            # A fresh run still writes its key, so later runs can reuse it.
            --rebuild|--no-cache)         shift ;;
            --workers)                    shift 2 ;;
            # Each file's run dir is handed to it; where results go is no part of a cache key.
            --out)                        shift 2 ;;
            --verify|--export)            ver_args+=("$1"); shift ;;
            --review)                     [[ "$VERIFY" == 1 ]] || gen_args+=("$1"); shift ;;
            --verify-repo|--verify-arg)   ver_args+=("$1" "$2"); shift 2 ;;
            --target|--repo|--docker-arg) gen_args+=("$1" "$2"); ver_args+=("$1" "$2"); shift 2 ;;
            *)                            gen_args+=("$1"); shift ;;
        esac
    done
    # A file whose blobs, before and after, are the ones an earlier run of this PR
    # with the same options mutated gets that run's mutants back instead of a new
    # agent: a force-push that leaves the file alone changes nothing they were cut
    # from. They are still verified again, at the new head, whose tests may differ.
    declare -A blobs_of=()
    while IFS=$'\t' read -r f idx; do blobs_of[$f]="$idx"; done < <(awk '
        /^diff --git / { idx = "" }
        /^index /      { idx = $2 }
        /^\+\+\+ b\//  { print substr($0, 7) "\t" idx }' <<< "$diff")
    pr_json="$(curl -fsSL --retry 3 "https://api.github.com/repos/${REPO_PATH}/pulls/$PR")" || pr_json=""
    pr_commits="$(curl -fsSL --retry 3 "https://api.github.com/repos/${REPO_PATH}/pulls/$PR/commits?per_page=100")" || pr_commits=""
    head=""
    command -v jq >/dev/null && head="$(jq -r '.head.sha // empty' <<< "$pr_json")"
    cached_run() {  # cached_run <file> <key>: the newest earlier run dir made with that key
        local d found=""
        for d in "$OUT_ROOT/pr-$PR-"*/"$(slug_of "$1")"/; do
            d="${d%/}"
            [[ ! -L "$d" && -f "$d/cache-key" && "$(< "$d/cache-key")" == "$2" && -s "$d/out/mutants.json" ]] \
                && found="$d"
        done
        printf '%s' "$found"
    }

    # One stamp for every file, so each run dir is known here.
    stamp="$(date -u +%Y%m%dT%H%M%SZ)"
    run_root="$OUT_ROOT/pr-$PR-$stamp"
    SUMMARY_FILE="$run_root/summary.json"
    SUMMARY_DIRS=()
    for f in "${files[@]}"; do SUMMARY_DIRS+=("$run_root/$(slug_of "$f")"); done
    # What the harness itself brings to a run: the image, the scripts in it, the
    # prompts and the profile. A change to any of them must not reuse old mutants.
    harness_key="v$IMAGE_VERSION-$(cat "$HERE"/docker/{Dockerfile,entrypoint.sh,verify-entrypoint.sh,tu-check} \
        "$HERE/prompts/$TARGET_NAME"/*.md "$PROFILE" | git hash-object --stdin | cut -c1-12)"
    pids=() keys=()
    for f in "${files[@]}"; do
        key="${blobs_of[$f]:-} $harness_key $AGENT $MODEL ${gen_args[*]}"
        keys+=("$key")
        prev=""
        [[ "$NO_CACHE" == 1 ]] || prev="$(cached_run "$f" "$key")"
        if [[ -n "$prev" && -n "$head" ]]; then
            log "=== $f: unchanged since ${prev#"$OUT_ROOT"/}; reusing its mutants ==="
            dir="$run_root/$(slug_of "$f")"
            # The old review stream goes too: its cost is not this run's.
            mkdir -p "$dir/work" && cp -r "$prev/out" "$dir/" && rm -rf "$dir/out/verify" "$dir/out/review.stream.jsonl"
            # Name the run that generated them, not one that reused them too.
            if [[ -f "$prev/reused-from" ]]; then cp "$prev/reused-from" "$dir/"
            else printf '%s\n' "${prev#"$OUT_ROOT"/}" > "$dir/reused-from"; fi
            for j in mutants.json report.json; do
                jq --arg c "$head" '.repo.commit = $c' "$dir/out/$j" > "$dir/out/$j.tmp" \
                    && mv "$dir/out/$j.tmp" "$dir/out/$j"
            done
            pids+=(cached)
            continue
        fi
        log "=== $f: generating ==="
        # Hand each run what was fetched above: one fetch per file would spend the
        # unauthenticated API's 60 requests an hour on a single PR.
        work="$run_root/$(slug_of "$f")/work"
        mkdir -p "$work" && printf '%s\n' "$diff" > "$work/pr.diff"
        [[ -n "$pr_json" ]] && printf '%s\n' "$pr_json" > "$work/pr.json"
        [[ -n "$pr_commits" ]] && printf '%s\n' "$pr_commits" > "$work/pr-commits.json"
        MUTANT_HARNESS_STAMP="$stamp" MUTANT_HARNESS_RUN_DIR="$run_root/$(slug_of "$f")" "$0" "${gen_args[@]}" --file "$f" &
        pids+=("$!")
    done
    failed=() generated=()
    for i in "${!files[@]}"; do
        if [[ "${pids[$i]}" == cached ]] || wait "${pids[$i]}"; then
            generated+=("${files[$i]}")
            printf '%s\n' "${keys[$i]}" > "$run_root/$(slug_of "${files[$i]}")/cache-key"
        else
            failed+=("${files[$i]}")
        fi
    done
    if [[ "$VERIFY" == 1 ]]; then
        # One at a time until a file has run the baseline, which also leaves the
        # volume built at this commit.
        queue=(${generated[@]+"${generated[@]}"})
        baseline=()
        while (( ${#queue[@]} )) && (( ${#baseline[@]} == 0 )); do
            f="${queue[0]}"; queue=("${queue[@]:1}")
            dir="$run_root/$(slug_of "$f")"
            log "=== $f: verifying ==="
            "$0" "${ver_args[@]}" --verify-only "$dir" || { failed+=("$f"); continue; }
            # No verify dir means nothing was runnable, and no baseline ran.
            [[ -d "$dir/out/verify" ]] && baseline=(--verify-arg --no-baseline)
        done
        # The rest are shared out between workers, each with its own copy of that
        # built volume: they cannot share one build tree. A host clone is one
        # tree, so --verify-repo stays serial.
        n="$WORKERS"
        [[ -n "$VERIFY_REPO" ]] && n=1
        (( n > ${#queue[@]} )) && n=${#queue[@]}
        claims="$(mktemp -d)"
        vols=("$VERIFY_VOLUME")
        for ((w = 2; w <= n; w++)); do
            vols+=("$VERIFY_VOLUME-w$w")
            log "copying build volume $VERIFY_VOLUME to ${vols[-1]}"
            # Mounted where the image's world-writable build dir is, a new volume
            # takes that mode; anywhere else it is root's. cp -a keeps the mtimes
            # that tell make it is all built.
            docker run --rm --user "$(id -u):$(id -g)" -v "$VERIFY_VOLUME:/a:ro" -v "${vols[-1]}:/src/bitcoin/build" \
                --entrypoint sh "$IMAGE" -c 'find /src/bitcoin/build -mindepth 1 -delete \
                    && find /a -mindepth 1 -maxdepth 1 -exec cp -a -t /src/bitcoin/build {} +' \
                || die "cannot copy build volume $VERIFY_VOLUME to ${vols[-1]}"
        done
        wpids=()
        for ((w = 0; w < n; w++)); do
            (
                # Each file goes to whichever worker claims it first.
                for i in "${!queue[@]}"; do
                    mkdir "$claims/$i" 2>/dev/null || continue
                    f="${queue[$i]}"
                    log "=== $f: verifying (worker $((w + 1))) ==="
                    MUTANT_HARNESS_BUILD_VOLUME="${vols[$w]}" "$0" "${ver_args[@]}" \
                        ${baseline[@]+"${baseline[@]}"} --verify-only "$run_root/$(slug_of "$f")" \
                        || printf '%s\n' "$f" >> "$claims/failed"
                done
            ) &
            wpids+=("$!")
        done
        (( ${#wpids[@]} )) && wait "${wpids[@]}"
        [[ -f "$claims/failed" ]] && mapfile -t -O "${#failed[@]}" failed < "$claims/failed"
        rm -rf "$claims"
        if [[ "$REVIEW" == 1 ]]; then
            log "=== reviewing the mutants that survived ==="
            mapfile -d '' rev < <(review_args)
            "$0" ${rev[@]+"${rev[@]}"} --review-only "$run_root" || failed+=("review")
        fi
    fi
    # One table for the whole PR, so no run has to be read from the interleaved log.
    if command -v jq >/dev/null; then
        {
            printf '# pull request #%s\n\nhead: %s\nrun: %s\n' "$PR" "${head:-?}" "$stamp"
            for f in "${files[@]}"; do
                dir="$run_root/$(slug_of "$f")"
                src="generated in this run"
                [[ -f "$dir/reused-from" ]] && src="reused from $(< "$dir/reused-from")"
                printf '\n## %s\n\n%s\n\n' "$f" "$src"
                if [[ ! -s "$dir/out/mutants.json" ]]; then echo "no mutants.json: generation failed"; continue; fi
                results=/dev/null
                [[ -s "$dir/out/verify/results.jsonl" ]] && results="$dir/out/verify/results.jsonl"
                jq -r --slurpfile r "$results" '
                    if (.mutants // []) == [] then "no mutants" else
                    "| mutant | severity | result | time | title |",
                    "|---|---|---|---|---|",
                    (.mutants[] | .id as $id | ([$r[] | select(.id == $id)] | last) as $v |
                        "| \(.id) | \(.severity_if_undetected // "?") | " +
                        (if $v then $v.status + (if $v.killed_tests then " (\($v.killed_by): \($v.killed_tests | join(", ")))" else "" end)
                         elif .apply_ok == false then "does not apply"
                         elif .compiles == false then "does not compile"
                         else "not verified" end) +
                        " | \(if $v.seconds then "\($v.seconds)s" else "" end) | \(.title | gsub("\\|"; "\\|")) |")
                    end' "$dir/out/mutants.json"
            done
        } > "$run_root/summary.md"
        log "summary: $run_root/summary.md"
    fi
    (( ${#failed[@]} == 0 )) || die "failed: ${failed[*]}"
    log "all ${#files[@]} file(s) of pull request #$PR done"
    exit 0
fi

# ----------------------------------------------------------------- args ----
[[ -n "$TARGET_FILE" ]] || die "--file is required (e.g. --file src/script/interpreter.cpp)"
# The path is resolved inside the container against the Core tree, so keep it
# relative and refuse anything that could escape it.
TARGET_FILE="${TARGET_FILE#./}"
[[ "$TARGET_FILE" != /* ]]   || die "--file must be relative to the Core tree, got: $TARGET_FILE"
[[ "$TARGET_FILE" != *..* ]] || die "--file must not contain '..': $TARGET_FILE"
[[ -n "$COUNT" ]] || { [[ -n "$PR" ]] && COUNT=6 || COUNT=12; }
[[ "$COUNT" =~ ^[0-9]+$ ]] && (( COUNT > 0 )) || die "--count takes a positive number, got: $COUNT"
[[ -z "$LINE_RANGE" || "$LINE_RANGE" =~ ^[0-9]+-[0-9]+$ ]] || die "--lines takes a-b, got: $LINE_RANGE"
[[ -z "$PR" || "$PR" =~ ^[0-9]+$ ]] || die "--pr takes a pull request number, got: $PR"
[[ -z "$PR" || "$UPDATE_CORE" == 0 ]] || die "--pr and --update-core both pick the commit; pick one"
[[ -z "$PR" || -z "$LINE_RANGE" ]] || die "--pr picks the lines itself (the ones it adds); drop --lines"

SLUG="$(slug_of "$TARGET_FILE")"

# ------------------------------------------------------------- run dir ----
STAMP="${MUTANT_HARNESS_STAMP:-$(date -u +%Y%m%dT%H%M%SZ)}"
RUN_DIR="${MUTANT_HARNESS_RUN_DIR:-$OUT_ROOT/$SLUG-$STAMP}"
WORK_DIR="$RUN_DIR/work"
OUT_DIR="$RUN_DIR/out"
mkdir -p "$WORK_DIR" "$OUT_DIR/patches"

# With verification the review waits for it; see review_args.
REVIEW_AFTER_VERIFY=0
if [[ "$REVIEW" == 1 && "$VERIFY" == 1 && -z "$REVIEW_ONLY_COMMIT" ]]; then
    REVIEW=0 REVIEW_AFTER_VERIFY=1
fi

# A review-only run keeps the prompt the mutants were generated with.
[[ -n "$REVIEW_ONLY_COMMIT" ]] || cp "$HERE/prompts/$TARGET_NAME/mutate.md" "$WORK_DIR/prompt.md"
cp "$HERE/prompts/$TARGET_NAME/review.md" "$WORK_DIR/review.md"

# ------------------------------------------------------------------ auth ----
AUTH_ARGS=()
if [[ "$AGENT" == codex ]]; then
    if [[ -n "${OPENAI_API_KEY:-}" ]]; then
        log "auth: OPENAI_API_KEY"
        AUTH_ARGS+=(-e "OPENAI_API_KEY=$OPENAI_API_KEY")
    elif [[ -r "${CODEX_HOME:-$HOME/.codex}/auth.json" ]]; then
        log "auth: copy of Codex auth.json (host file untouched)"
        mkdir -p "$WORK_DIR/codex-home"
        cp "${CODEX_HOME:-$HOME/.codex}/auth.json" "$WORK_DIR/codex-home/auth.json"
        chmod 600 "$WORK_DIR/codex-home/auth.json"
        AUTH_ARGS+=(-v "$(cd "$WORK_DIR/codex-home" && pwd):/home/agent/.codex")
    else
        die "no auth: set OPENAI_API_KEY or log in with Codex (auth.json)"
    fi
elif [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
    log "auth: ANTHROPIC_API_KEY"
    AUTH_ARGS+=(-e "ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY")
elif [[ -r "$HOME/.claude/.credentials.json" ]]; then
    log "auth: copy of ~/.claude/.credentials.json (host file untouched)"
    mkdir -p "$WORK_DIR/claude-home"
    cp "$HOME/.claude/.credentials.json" "$WORK_DIR/claude-home/.credentials.json"
    chmod 600 "$WORK_DIR/claude-home/.credentials.json"
    AUTH_ARGS+=(-v "$(cd "$WORK_DIR/claude-home" && pwd):/home/agent/.claude")
else
    die "no auth: set ANTHROPIC_API_KEY or log in on the host (~/.claude/.credentials.json)"
fi

# ------------------------------------------------------------------- run ----
CONTAINER="mutant-harness-$SLUG-$STAMP"
DOCKER_ARGS=(
    run --rm
    --name "$CONTAINER"
    --user "$(id -u):$(id -g)"
    -v "$(cd "$WORK_DIR" && pwd):/work"
    -v "$(cd "$OUT_DIR" && pwd):/out"
    -e "TARGET_FILE=$TARGET_FILE"
    -e "MUTANT_COUNT=$COUNT"
    -e "FOCUS=$FOCUS"
    -e "LINE_RANGE=$LINE_RANGE"
    -e "OPS=$OPS"
    -e "STRUCTURAL=$STRUCTURAL"
    -e "PROMPT_TEMPLATE=/work/prompt.md"
    -e "REVIEW_PROMPT_TEMPLATE=/work/review.md"
    -e "REPORT_FILE=/out/report.json"
    -e "MANIFEST_FILE=/out/mutants.json"
    -e "REVIEWED_FILE=/out/mutants-reviewed.json"
    -e "PATCH_DIR=/out/patches"
    -e "REVIEW=$REVIEW"
    -e "REVIEW_MODEL=$REVIEW_MODEL"
    -e "REVIEW_ONLY_COMMIT=$REVIEW_ONLY_COMMIT"
    -e "OUT_DIR=/out"
    -e "MODEL=$MODEL"
    -e "AGENT=$AGENT"
    -e "FALLBACK_MODEL=$FALLBACK_MODEL"
    -e "UPDATE_CORE=$UPDATE_CORE"
    -e "PR=$PR"
    -e "REPO_URL=$REPO_URL"
    -e "UPDATE_BIPS=$UPDATE_BIPS"
    -e "HOME=/home/agent"
)
[[ -n "$REPO_MOUNT" ]] && {
    [[ -d "$REPO_MOUNT/.git" ]] || die "--repo $REPO_MOUNT is not a git clone"
    DOCKER_ARGS+=(-v "$(cd "$REPO_MOUNT" && pwd):/src/bitcoin")
    warn "using host $TARGET_NAME clone: $REPO_MOUNT (the agent edits and reverts files in it)"
}
[[ -n "$BIPS_REPO_MOUNT" ]] && {
    [[ -d "$BIPS_REPO_MOUNT/.git" ]] || die "--bips-repo $BIPS_REPO_MOUNT is not a git clone"
    DOCKER_ARGS+=(-v "$(cd "$BIPS_REPO_MOUNT" && pwd):/src/bips")
    log "using host bips clone: $BIPS_REPO_MOUNT"
}
DOCKER_ARGS+=("${AUTH_ARGS[@]}")
[[ ${#EXTRA_DOCKER_ARGS[@]} -gt 0 ]] && DOCKER_ARGS+=("${EXTRA_DOCKER_ARGS[@]}")

if [[ "$SHELL_MODE" == 1 ]]; then
    log "shell mode: entering $IMAGE"
    exec docker "${DOCKER_ARGS[@]}" -it --entrypoint /bin/bash "$IMAGE"
fi

if [[ "$DETACH" == 1 ]]; then
    docker "${DOCKER_ARGS[@]}" -d "$IMAGE" >/dev/null
    log "running detached as $CONTAINER"
    log "  logs:    docker logs -f $CONTAINER"
    log "  results: $OUT_DIR/mutants.json"
    exit 0
fi

log "run dir: $RUN_DIR"
trap report_time EXIT
# A file of a --pr run, or a --review-only, is summed up by whoever started it.
[[ -n "${MUTANT_HARNESS_RUN_DIR:-}" ]] || { SUMMARY_FILE="$RUN_DIR/summary.json"; SUMMARY_DIRS=("$RUN_DIR"); }
if [[ -n "$REVIEW_ONLY_COMMIT" ]]; then
    log "reviewing the mutants of $TARGET_FILE (model=${REVIEW_MODEL:-$MODEL}) ..."
else
    log "mutating $TARGET_FILE (target $COUNT mutants, model=$MODEL) ..."
fi

set +e
if [[ -n "$TIMEOUT" ]]; then
    command -v timeout >/dev/null || die "--timeout needs coreutils timeout(1)"
    timeout --signal=TERM "$TIMEOUT" docker "${DOCKER_ARGS[@]}" "$IMAGE"
    RC=$?
    [[ $RC == 124 ]] && { warn "timed out after $TIMEOUT"; docker kill "$CONTAINER" >/dev/null 2>&1; }
else
    docker "${DOCKER_ARGS[@]}" "$IMAGE"
    RC=$?
fi
set -e

MANIFEST="$OUT_DIR/mutants.json"
REVIEWED="$OUT_DIR/mutants-reviewed.json"

# Show the reviewed file when the second pass produced one, so the verdicts are
# what you read first.
SUMMARY_SRC="$MANIFEST"
[[ -s "$REVIEWED" ]] && command -v jq >/dev/null \
    && jq empty "$REVIEWED" 2>/dev/null && SUMMARY_SRC="$REVIEWED"

if [[ -s "$MANIFEST" ]] && command -v jq >/dev/null && jq empty "$MANIFEST" 2>/dev/null; then
    [[ -n "${MUTANT_HARNESS_RUN_DIR:-}" ]] || ln -sfn "$(cd "$RUN_DIR" && pwd)" "$OUT_ROOT/$SLUG-latest"
    echo
    jq -r '
      "target: \(.target.file // "?")  (\(.target.lines // "whole file"))",
      "\(.harness.target // "core"): \(.repo.commit[0:12] // "?")",
      "\((.mutants // []) | length) mutants, " +
        "\([.mutants[]? | select(.apply_ok == false)] | length) that do not apply, " +
        "\([.mutants[]? | select(.line_level)] | length) line-level" +
        "\(if .harness.structural then " (not verified, --structural)" else "" end)",
      (if .review then
         "review: \(.review.good // 0) good, \(.review.dead // 0) dead, " +
         "\(.review.noise // 0) noise, \(.review.invalid // 0) invalid"
       else "review: not run" end),
      "",
      ((.mutants // []) | sort_by(
          [((.verdict // "good") as $v
              | ["good","noise","dead","invalid"] | index($v) // 9),
           (.severity_if_undetected as $s
              | ["critical","high","medium","low"] | index($s) // 9)]
        )[] |
        "  \(.id) [\(.severity_if_undetected // "?")]" +
        "\(if .verdict then " [\(.verdict)]" else "" end)" +
        "\(if .line_level then " [line-level]" else "" end) " +
        "\(.operator // "?") @\(.location.lines // "?"): \(.title)" +
        "\(if .apply_ok == false then "\n      does not apply: \(.apply_error // "?" | split("\n")[0])" else "" end)"),
      "",
      "summary: \(.summary // "")"
    ' "$SUMMARY_SRC"
    echo
    if [[ "$SUMMARY_SRC" == "$REVIEWED" ]]; then
        log "reviewed mutants: $REVIEWED   <- start here"
        log "raw mutants:      $MANIFEST"
        log "review trace:     $OUT_DIR/review.txt"
    else
        log "mutants:          $MANIFEST"
    fi
    log "patches:          $OUT_DIR/patches/"
    log "full report:      $OUT_DIR/report.json"
    log "trace:            $OUT_DIR/session.txt"
    log "apply one:        mutant-harness --apply $OUT_DIR/patches/mut-001.patch --repo <core-clone>"
    [[ "$VERIFY" == 1 ]] \
        || log "verify all:       mutant-harness --verify-only $RUN_DIR"

    if [[ "$REVIEW_AFTER_VERIFY" == 1 ]]; then
        # run_verification exits; the subshell keeps that from ending us too.
        ( run_verification "$OUT_DIR" "$CONTAINER-verify" ); rc=$?
        mapfile -d '' rev < <(review_args)
        "$0" ${rev[@]+"${rev[@]}"} --review-only "$RUN_DIR" || rc=$(( rc ? rc : 1 ))
        exit "$rc"
    fi
    [[ "$VERIFY" == 1 ]] && run_verification "$OUT_DIR" "$CONTAINER-verify"
    exit 0
fi

warn "no valid mutants.json produced (container rc=$RC)"
warn "inspect: $OUT_DIR/session.stream.jsonl"
exit "${RC:-1}"
